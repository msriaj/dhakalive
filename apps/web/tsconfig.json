{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@payload-config": ["./src/payload.config.ts"],
      "@/*": ["./src/*"]
    }
  },
  // Workspace packages are consumed through their compiled `dist` declarations,
  // so their source (and their tests) must not be pulled into this program.
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `src/migrations` is generated by `payload migrate:create` and is not written
  // to this project's lint/strictness rules — its handlers declare `payload` and
  // `req` whether or not a given migration uses them, which trips
  // `noUnusedParameters`. Relaxing that flag repo-wide to accommodate generated
  // code would be the wrong trade; the migrations are validated by running them.
  "exclude": ["node_modules", ".next", "dist", "src/migrations"]
}
