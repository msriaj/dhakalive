    "@payloadcms/storage-s3": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "graphql": "16.14.2",
    "next": "16.3.0",
    "payload": "3.87.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "pg": "8.20.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
