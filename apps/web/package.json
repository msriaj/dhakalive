{
  "name": "@dhakalive/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "node --env-file-if-exists=../../.env node_modules/payload/bin.js",
    "migrate": "node --env-file-if-exists=../../.env node_modules/payload/bin.js migrate",
    "migrate:create": "node scripts/migrate-create.mjs",
    "migrate:status": "node --env-file-if-exists=../../.env node_modules/payload/bin.js migrate:status",
    "generate:types": "node --env-file-if-exists=../../.env node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --env-file-if-exists=../../.env node_modules/payload/bin.js generate:importmap",
    "migrate:down": "node --env-file-if-exists=../../.env node_modules/payload/bin.js migrate:down",
    "normalize:migrations": "node scripts/normalize-migrations.mjs"
  },
  "dependencies": {
    "@dhakalive/cache": "workspace:*",
