# =============================================================================
# DhakaLive — environment template
#
# Copy to `.env` and fill in. Every value below is a placeholder; none of them
# are real credentials and none of them are safe to use outside local dev.
#
# Validation lives in packages/config/src/env.ts and runs at boot. A missing or
# malformed value fails the process immediately with the offending key names —
# values are never echoed. See docs/environment.md for the full reference.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# NODE_ENV is a build concept — `next build` forces it to `production` even
# locally. APP_ENV is the deployment stage and is what the production safety
# rules (TLS required, R2 required, schema push refused) actually check.
# development | test | staging | production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# --- Public site identity ----------------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=bn
# Commit SHA or release tag; surfaced by /api/health for deploy correlation.
NEXT_PUBLIC_APP_VERSION=dev

# --- Payload -----------------------------------------------------------------
# Signs auth cookies and password-reset tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-at-least-32-random-characters

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URI=postgres://dhakalive:dhakalive@localhost:5432/dhakalive
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Must be true in production; validation refuses to start without it.
DATABASE_SSL=false
# Drizzle `push` rewrites schema with no migration file, and mixing it with
# committed migrations causes drift that makes `payload migrate` refuse to run.
# Leave false: local schema changes go through migrate:create like everywhere
# else. Flip to true only for throwaway rapid iteration, then reset the database.
# Validation refuses to enable this when APP_ENV=production.
DATABASE_PUSH=false

# --- Cloudflare R2 (media storage, S3-compatible) ----------------------------
# Required in production: media is never written to container disk.
# Run `pnpm verify:r2` after filling these in — it does a real write/read/delete
# round trip, so a wrong endpoint or a read-only token fails here rather than on
# an editor's first upload. See docs/r2-storage.md for where each value lives.
#
# R2 -> Overview, or the dashboard URL after /accounts/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=dhakalive
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
# R2 has no regions, but the S3 client requires one. `auto` is the documented value.
CLOUDFLARE_R2_REGION=auto
# R2 requires path-style addressing.
CLOUDFLARE_R2_FORCE_PATH_STYLE=true
# Public custom domain bound to the bucket, e.g. https://media.example.com
# The bucket's r2.dev URL also works for testing.
CLOUDFLARE_MEDIA_PUBLIC_URL=

# --- Cloudflare cache purge --------------------------------------------------
# Must be set together, or purges silently no-op. Token needs only Zone > Cache
# Purge on this one zone — do not reuse a global API key.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Tag and prefix purge are Cloudflare Enterprise features. Leave false on other
# plans and the purge client falls back to single-file URL purge.
CLOUDFLARE_PURGE_BY_TAG=false

# --- Revalidation ------------------------------------------------------------
# Shared secret for the on-demand revalidation endpoint. Minimum 16 characters.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=replace-me-with-a-random-value

# --- Redis (rate limiting, distributed cache) --------------------------------
REDIS_URL=redis://localhost:6379

# --- Search ------------------------------------------------------------------
# postgres | meilisearch | opensearch
SEARCH_PROVIDER=postgres
# Required when SEARCH_PROVIDER is not `postgres`.
SEARCH_URL=
SEARCH_API_KEY=

# --- Email -------------------------------------------------------------------
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Background jobs ---------------------------------------------------------
# Only the worker container sets this to true. If a web replica enables it,
# every replica races to publish the same scheduled article.
JOBS_RUN_IN_PROCESS=false
JOBS_POLL_INTERVAL_MS=10000

# --- Error tracking ----------------------------------------------------------
ERROR_TRACKING_DSN=
