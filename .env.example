# =============================================================================
# DhakaLive — environment template
#
# Copy to `.env` and fill in. Every value below is a placeholder; none of them
# are real credentials and none of them are safe to use outside local dev.
#
# Validation lives in packages/config/src/env.ts and runs at boot. A missing or
# malformed value fails the process immediately with the offending key names —
# values are never echoed. See docs/environment.md for the full reference.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# NODE_ENV is a build concept — `next build` forces it to `production` even
# locally. APP_ENV is the deployment stage and is what the production safety
# rules (TLS required, R2 required, schema push refused) actually check.
# development | test | staging | production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# --- Public site identity ----------------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostname Caddy serves TLS for. Must match what Cloudflare sends, or the proxy
# gets a certificate for the wrong name. Usually NEXT_PUBLIC_SITE_URL without
# the scheme.
SITE_DOMAIN=dhakalive.com
NEXT_PUBLIC_DEFAULT_LOCALE=bn
# Commit SHA or release tag; surfaced by /api/health for deploy correlation.
NEXT_PUBLIC_APP_VERSION=dev
# Who resizes images: `cloudflare` (default) hands the work to /cdn-cgi/image/
# at the edge, which also lets Cloudflare pick AVIF per browser rather than the
# origin encoding it; `next` runs sharp in the web container on the request
# path, which is the behaviour this replaced.
#
# `cloudflare` requires Image Transformations to be enabled for the media zone.
# On a zone without them every transformation URL returns 404 — which is every
# image on the site — so check before deploying a build that relies on it:
#
#   curl -sI "https://media.dhakalive.com/cdn-cgi/image/width=64/<file>.webp"
#
# 200 means enabled; 404 means it is off and this must be set to `next`.
#
# Transformations are billed per unique transformation, and the endpoint is
# public: anyone can request arbitrary widths against the media zone and each
# distinct one is billable. Keep the Cloudflare-side restriction on allowed
# transformation sources in place, or that is someone else's spending decision.
#
# Read at build time, so changing it needs a rebuild rather than a restart.
NEXT_PUBLIC_IMAGE_CDN=cloudflare
# GA4 measurement id. Defaults to the site's own property in code, so this only
# needs setting to point a build somewhere else — a staging property, or a fork.
# Read at build time, so a change needs a rebuild rather than a restart. The tag
# is only emitted by production builds; `pnpm dev` never reports.
# NEXT_PUBLIC_GA_ID=

# --- Payload -----------------------------------------------------------------
# Signs auth cookies and password-reset tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-me-with-at-least-32-random-characters

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URI=postgres://dhakalive:dhakalive@localhost:5432/dhakalive
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Must be true in production, unless Postgres runs on the same host and is only
# reachable over the container network — then set DATABASE_ALLOW_UNENCRYPTED=true
# below. Startup refuses any other combination.
DATABASE_SSL=false
# Waives the TLS requirement above. Honoured only when DATABASE_URI points at a
# loopback, private-range or container-alias host; ignored for a remote database.
DATABASE_ALLOW_UNENCRYPTED=false
# Drizzle `push` rewrites schema with no migration file, and mixing it with
# committed migrations causes drift that makes `payload migrate` refuse to run.
# Leave false: local schema changes go through migrate:create like everywhere
# else. Flip to true only for throwaway rapid iteration, then reset the database.
# Validation refuses to enable this when APP_ENV=production.
DATABASE_PUSH=false

# --- Self-hosted PostgreSQL container ----------------------------------------
# Only needed when running docker/docker-compose.postgres.yml — that is, when
# PostgreSQL runs on the same box rather than as a managed service. Unused
# locally and unused with a managed database.
#
# POSTGRES_PASSWORD is REQUIRED by that compose file and has no default: the
# stack refuses to start rather than come up with a guessable password. It must
# match the password in DATABASE_URI above.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=dhakalive
POSTGRES_DB=dhakalive

# Resource tuning. Defaults suit a 2 GB droplet shared with the app, worker and
# Redis; raise them after a resize. Limits are caps, not reservations, so their
# sum may exceed RAM.
# APP_MEMORY_LIMIT=768m
# WORKER_MEMORY_LIMIT=384m
# REDIS_MEMORY_LIMIT=128m
# REDIS_MAXMEMORY=96mb
# POSTGRES_MEMORY_LIMIT=512m
# POSTGRES_SHARED_BUFFERS=192MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=640MB
# POSTGRES_MAX_CONNECTIONS=50

# --- Cloudflare R2 (media storage, S3-compatible) ----------------------------
# Required in production: media is never written to container disk.
# Run `pnpm verify:r2` after filling these in — it does a real write/read/delete
# round trip, so a wrong endpoint or a read-only token fails here rather than on
# an editor's first upload. See docs/r2-storage.md for where each value lives.
#
# R2 -> Overview, or the dashboard URL after /accounts/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=dhakalive
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=
# R2 has no regions, but the S3 client requires one. `auto` is the documented value.
CLOUDFLARE_R2_REGION=auto
# R2 requires path-style addressing.
CLOUDFLARE_R2_FORCE_PATH_STYLE=true
# Public custom domain bound to the bucket, e.g. https://media.example.com
# The bucket's r2.dev URL also works for testing.
CLOUDFLARE_MEDIA_PUBLIC_URL=

# --- Cloudflare cache purge --------------------------------------------------
# Must be set together, or purges silently no-op. Token needs only Zone > Cache
# Purge on this one zone — do not reuse a global API key.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Tag and prefix purge are Cloudflare Enterprise features. Leave false on other
# plans and the purge client falls back to single-file URL purge.
CLOUDFLARE_PURGE_BY_TAG=false

# --- Revalidation ------------------------------------------------------------
# Shared secret for the on-demand revalidation endpoint. Minimum 16 characters.
# Generate with: openssl rand -hex 32
REVALIDATION_SECRET=replace-me-with-a-random-value

# --- Redis (rate limiting, distributed cache) --------------------------------
REDIS_URL=redis://localhost:6379

# --- Search ------------------------------------------------------------------
# postgres | meilisearch | opensearch
SEARCH_PROVIDER=postgres
# Required when SEARCH_PROVIDER is not `postgres`.
SEARCH_URL=
SEARCH_API_KEY=

# --- Email -------------------------------------------------------------------
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Background jobs ---------------------------------------------------------
# Only the worker container sets this to true. If a web replica enables it,
# every replica races to publish the same scheduled article.
JOBS_RUN_IN_PROCESS=false
JOBS_POLL_INTERVAL_MS=10000

# --- Social auto-posting -----------------------------------------------------
# Posts a branded photocard when an article is published — to Facebook,
# Instagram and Threads by default; trim the list to drop a platform.
# The switch is separate from the credentials on purpose: staging can hold a
# real API key without posting to the real audience. Credentials come from
# https://app.upload-post.com/api-keys; the profile must have each platform's
# account connected. The page id is only needed when the profile has more than
# one Facebook page connected and none pinned.
SOCIAL_AUTOPOST_ENABLED=false
SOCIAL_AUTOPOST_PLATFORMS=facebook,instagram,threads,linkedin,x
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=
UPLOAD_POST_FACEBOOK_PAGE_ID=
# Human approval before posting: the card goes to a Telegram group with
# Approve/Decline buttons, and nothing posts until someone taps Approve.
# On by default (only matters when SOCIAL_AUTOPOST_ENABLED is true); set to
# false for instant auto-posting. Bot token from @BotFather; chat id defaults
# to the editors' group; the webhook secret is yours to mint
# (openssl rand -hex 16) and must also be passed to setWebhook.
SOCIAL_APPROVAL_REQUIRED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Error tracking ----------------------------------------------------------
ERROR_TRACKING_DSN=
